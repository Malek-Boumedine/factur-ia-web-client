# Modèle de configuration : copier vers .env puis remplacer les valeurs.
#   cp .env.example .env
# Le .env réel ne doit JAMAIS être commité (un hook bloque les secrets).

# Environnement (dev, test, prod) — sélectionne config/settings/<env>.py
DJANGO_ENV=dev

# Sécurité — générer avec : openssl rand -hex 32
SECRET_KEY=remplacer-par-une-cle-generee
DEBUG=True

# Hôtes autorisés (en prod : les domaines réels, sans *)
ALLOWED_HOSTS=localhost,127.0.0.1

# API data (backend FastAPI) — le BFF relaie tous les appels vers elle
API_DATA_URL=http://127.0.0.1:8080

# Redis : broker/résultats Celery et sessions Django (en Docker, le compose
# surcharge ces URLs vers le service redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Token GitHub pour python-semantic-release (CI uniquement, optionnel en local)
# RELEASE_TOKEN=

# Résilience des appels vers l'API data (timeouts en secondes)
API_CONNECT_TIMEOUT=5.0
API_READ_TIMEOUT=15.0
API_MAX_RETRIES=2
API_RETRY_BACKOFF=0.5

# Inscription publique : id du rôle attribué par défaut au compte créé
SIGNUP_DEFAULT_ROLE_ID=1

# Upload de documents : taille maximale acceptée avant relais vers l'API (octets)
DOCUMENT_UPLOAD_MAX_SIZE=10485760

# Observabilité (désactivée par défaut — voir README, section Observabilité)
# Métriques Prometheus + endpoint /metrics (aucun collector requis)
OTEL_METRICS_ENABLED=False
# Traces OpenTelemetry (export OTLP/HTTP vers un collector)
OTEL_ENABLED=False
# OTEL_SERVICE_NAME=factur-ia-web
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=console

# Journalisation : niveau global (INFO en local, WARNING conseillé en prod)
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Production uniquement (DJANGO_ENV=prod, Cloud Run) — ignoré en dev/test
# ------------------------------------------------------------------------------
# Origines HTTPS acceptées pour les POST (CSRF), avec schéma
# CSRF_TRUSTED_ORIGINS=https://factur-ia.example.com

# Authentification IAM Cloud Run : l'API data n'est joignable qu'avec un jeton
# d'identité Google (en-tête X-Serverless-Authorization, obtenu auprès du
# serveur de métadonnées — aucune clé). Laisser absent/False hors Cloud Run.
# API_IAM_AUTH_ENABLED=True

# Base de sessions : instance Cloud SQL MySQL 8.0, jointe par IP privée (TCP)
# DB_NAME=facturia_web
# DB_USER=facturia_web
# DB_PASSWORD=fourni-par-secret-manager
# DB_HOST=10.0.0.3
# DB_PORT=3306

# HSTS : courte durée au premier déploiement, 31536000 une fois validé
# SECURE_HSTS_SECONDS=3600

# Gunicorn : parallélisme par instance (défauts : 2 workers, 4 threads)
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=4
